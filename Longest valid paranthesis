class Solution {
public:
    int longestValidParentheses(string s) {
        int open=0;
        int close=0;
        int maxlen=0;
        for(int i=0;i<s.size();i++){
            if(s[i]=='(')
              open++;
            else
            close++;
            if(close>open){
                open=0;
                close=0;
            }
            else if(open==close){
                maxlen=max(maxlen,2*close);
            }  
        }
        open=0;
        close=0;
        for(int i=s.size()-1;i>=0;i--)
{
        if(s[i]=='(')
          open++;
          else
          close++;
          if(open>close)
          {
            open=0;
            close=0;
          }
          else if(open==close){
            maxlen=max(maxlen,2*open);
          }
}
return maxlen;
