class Solution {
public:
    int maxArea(vector<int>& height) {
        int i=0;
        int j=height.size()-1;
        int ans=0;
        int mini=0;
         while(i<j){
         if(height[i]<height[j]){
            mini=height[i];
            ans=max(ans,mini*(j-i));
            i++;
         }
         else{
              mini=height[j];
              ans=max(ans,mini*(j-i));
              j--;
         }
         }
         return ans;

    }
};
