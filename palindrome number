class Solution {
public:
    bool isPalindrome(int x) {
        long long num=0;
        if(x<0)
          return false;
        int y=x;
        while(x>0){
            int ld=x%10;
            num=num*10+ld;
            x=x/10;
        }
        if(num==y)
          return true;
          else
           return false;
    }
};
